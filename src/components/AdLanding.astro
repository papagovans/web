---
/*
 * One paid-traffic landing page, dressed to match stage.papagovans.com.
 *
 * Every ad page is this component plus a page of copy. The tracking, the
 * HubSpot form, the pricing block and the footer live here so a new avatar
 * cannot drift from the others, and so a fix to the conversion script lands
 * on every page at once.
 *
 * Deliberately no site nav: an ad page has one job. The header carries the
 * phone and a jump to the form, nothing else.
 *
 * Facts are the staging site's, checked 2026-09-25: $180,000 to $250,000
 * Tailored and $200,000 to $300,000 Bespoke, van included; keys in 14 weeks
 * on Tailored. Anything Tim's brief marks [CONFIRM] stays off these pages.
 */

interface Props {
	/** Sent with the Meta Lead event so each page's leads can be told apart. */
	slug: string;
	title: string;
	description: string;
	hero: { img: string; alt: string; eyebrow: string; h1: string; sub: string; checks: string[] };
	/** Three problem and solution pairs, matched to the ads that point here. */
	pairs: { problem: string; solution: string; body: string }[];
	scene: { img: string; alt: string; eyebrow: string; h2: string; paras: string[] };
	reviews: { name: string; quote: string }[];
	included: { h2: string; items: [string, string][] };
	faqs: { q: string; a: string }[];
	close: { h2: string; p: string };
}

const { slug, title, description, hero, pairs, scene, reviews, included, faqs, close } = Astro.props;

/* The ad pages' own line, switched in on 2026-09-17. The site publishes
   (480) 761-7175; keeping this one separate is what lets ad calls be counted. */
const PHONE = "(480) 724-8372";
const TEL = "tel:+14807248372";
const FORM_ID = "41078f26-c831-4179-a452-d316f1eac0db";
const CTA = "Get My Build Quote";

const paths = [
	{
		name: "Tailored",
		kicker: "Start from a proven floor plan",
		timing: "Keys in your hand: 14 weeks",
		copy: "Pick one of five layouts we have built dozens of times, then decide every system in it: power, water, heat, kitchen, storage, finishes.",
		range: "$180,000 - $250,000",
		featured: true,
	},
	{
		name: "Bespoke",
		kicker: "Start from an empty van",
		timing: "Keys in your hand: 9-14 months",
		copy: "No floor plan, just a blank Sprinter and a designer who draws it around how you actually travel. It takes the long way round, and for the right owner it is worth it.",
		range: "$200,000 - $300,000",
		featured: false,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" as="image" href={hero.img} fetchpriority="high" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Prompt:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<!-- Google tag (Papago Vans Google Ads: AW-11054135599) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=AW-11054135599"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { window.dataLayer.push(arguments); }
			gtag("js", new Date());
			gtag("config", "AW-11054135599");
		</script>

		<!-- Meta Pixel (Papago Vans's Pixel: 611277970549442) -->
		<script is:inline>
			!(function (f, b, e, v, n, t, s) {
				if (f.fbq) return;
				n = f.fbq = function () {
					n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
				};
				if (!f._fbq) f._fbq = n;
				n.push = n;
				n.loaded = !0;
				n.version = "2.0";
				n.queue = [];
				t = b.createElement(e);
				t.async = !0;
				t.src = v;
				s = b.getElementsByTagName(e)[0];
				s.parentNode.insertBefore(t, s);
			})(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
			fbq("init", "611277970549442");
			fbq("track", "PageView");
		</script>
		<noscript>
			<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=611277970549442&ev=PageView&noscript=1" />
		</noscript>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap header-inner">
				<a href="#top" class="logo" aria-label="Papago Vans">
					<img src="/home/Group-278.svg" alt="Papago Vans" width="174" height="27" />
				</a>
				<div class="header-actions">
					<a href={TEL} class="btn btn-outline btn-sm">{PHONE}</a>
					<a href="#quote" class="btn btn-gold btn-sm hide-sm">{CTA}</a>
				</div>
			</div>
		</header>

		<section class="hero" id="top">
			<img class="hero-img" src={hero.img} alt={hero.alt} fetchpriority="high" decoding="async" />
			<div class="wrap hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">{hero.eyebrow}</p>
					<h1>{hero.h1}</h1>
					<p class="hero-sub">{hero.sub}</p>
					<ul class="hero-checks">
						{hero.checks.map((c) => <li>{c}</li>)}
					</ul>
				</div>
				<div class="form-card" id="quote">
					<script src="https://js.hsforms.net/forms/embed/43782575.js" defer></script>
					<div class="hs-form-frame" data-region="na1" data-form-id={FORM_ID} data-portal-id="43782575"></div>
					<p class="form-note">Every price includes the Mercedes-Benz Sprinter.</p>
				</div>
			</div>
		</section>

		<div class="trust">
			<div class="wrap trust-inner">
				<span><b>4.7&#9733;</b> from 70+ verified reviews</span>
				<span>RVIA certified</span>
				<span>Veteran owned</span>
				<span>Built to order in Mesa, AZ</span>
			</div>
		</div>

		<section class="pairs">
			<div class="wrap pairs-grid">
				{pairs.map((p) => (
					<article class="pair">
						<p class="pair-problem">{p.problem}</p>
						<h2>{p.solution}</h2>
						<p>{p.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="scene">
			<div class="wrap scene-inner">
				<img src={scene.img} alt={scene.alt} loading="lazy" decoding="async" />
				<div class="scene-copy">
					<p class="eyebrow eyebrow-muted">{scene.eyebrow}</p>
					<h2>{scene.h2}</h2>
					{scene.paras.map((p) => <p>{p}</p>)}
				</div>
			</div>
		</section>

		<section class="paths">
			<div class="wrap">
				<h2 class="section-title">What It Costs</h2>
				<p class="section-lede">
					Two ways to build, both by hand in Mesa. Every price includes the
					Mercedes-Benz Sprinter, so the number is the whole number.
				</p>
				<div class="paths-grid">
					{paths.map((p) => (
						<article class={p.featured ? "path-card is-featured" : "path-card"}>
							{p.featured && <span class="path-flag">Most Popular</span>}
							<p class="path-kicker">{p.kicker}</p>
							<h3 class="path-name">{p.name}</h3>
							<p class="path-timing">{p.timing}</p>
							<p class="path-copy">{p.copy}</p>
							<div class="path-foot">
								<p class="path-range-label">Pricing range (includes van)</p>
								<p class="path-range">{p.range}</p>
								<a href="#quote" class={p.featured ? "btn btn-gold btn-block" : "btn btn-outline btn-block"}>
									{CTA} <span class="arw">&#8853;</span>
								</a>
							</div>
						</article>
					))}
				</div>
				<p class="paths-note">Financing available for the van and the build together, or the build on its own.</p>
			</div>
		</section>

		<section class="reviews">
			<div class="wrap">
				<h2 class="section-title">What Owners Say</h2>
				<div class="review-grid">
					{reviews.map((r) => (
						<figure class="review">
							<div class="stars" aria-label="Five out of five stars">
								{[0, 1, 2, 3, 4].map(() => (
									<svg viewBox="0 0 20 19" width="15" height="14" aria-hidden="true"><path d="M10 0l2.6 6.3 6.8.5-5.2 4.4 1.6 6.6L10 14.3 4.2 17.8l1.6-6.6L.6 6.8l6.8-.5z" /></svg>
								))}
							</div>
							<blockquote>&ldquo;{r.quote}&rdquo;</blockquote>
							<figcaption>{r.name}</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<section class="included">
			<div class="wrap included-inner">
				<h2 class="section-title">{included.h2}</h2>
				<ul class="included-grid">
					{included.items.map(([name, desc]) => (
						<li><strong>{name}</strong><span>{desc}</span></li>
					))}
				</ul>
			</div>
		</section>

		<section class="faqs">
			<div class="wrap faq-wrap">
				<h2 class="section-title">Questions, Answered</h2>
				<div class="faq-list">
					{faqs.map((f) => (
						<details class="faq">
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="close">
			<div class="wrap close-inner">
				<h2>{close.h2}</h2>
				<p>{close.p}</p>
				<a href="#quote" class="btn btn-gold">{CTA} <span class="arw">&#8853;</span></a>
				<p class="close-alt">Or call <a href={TEL}>{PHONE}</a></p>
			</div>
		</section>

		<footer class="site-footer">
			<img class="footer-art" src="/home/Frame-66.svg" alt="" aria-hidden="true" />
			<div class="wrap footer-inner">
				<img src="/home/Group-21-1.svg" alt="Papago Vans" width="120" height="72" />
				<ul class="footer-contact">
					<li>751 N Country Club Dr, Mesa, AZ 85201</li>
					<li><a href={TEL}>{PHONE}</a> &middot; <a href="mailto:info@papagovans.com">info@papagovans.com</a></li>
					<li><a href="https://papagovans.com/privacy-policy/">Privacy Policy</a></li>
				</ul>
				<p class="copyright">&copy; {new Date().getFullYear()} Papago Vans. All rights reserved</p>
			</div>
		</footer>

		<script is:inline define:vars={{ FORM_ID, slug }}>
			window.addEventListener("message", (event) => {
				const d = event.data;
				if (d?.type !== "hsFormCallback" || d?.eventName !== "onFormSubmitted" || d?.id !== FORM_ID) return;
				window.gtag?.("event", "conversion", {
					send_to: "AW-11054135599/I6MCKTNpIccEK_ygpcp",
					value: 1.0,
					currency: "USD",
				});
				window.fbq?.("track", "Lead", { content_name: slug });
			});
		</script>

		<style is:global>
			/* Tokens copied from stage.papagovans.com app/globals.css (Hybrid
			   direction). Change them there first, then here. */
			:root {
				--gold: #f4d969;
				--gold-deep: #e9ca47;
				--ink: #414042;
				--muted: #7b8591;
				--navy: #303c47;
				--line: #e6e0d2;
				--soft: #f2ede1;
				--paper: #fcfaf3;
				--bone: #f6f3ee;
				--r-lg: 16px;
				--r-md: 12px;
			}
			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; background: var(--paper); }
			body {
				margin: 0; font-family: Inter, sans-serif; font-size: 16px; line-height: 1.6;
				color: var(--ink); background: transparent; -webkit-font-smoothing: antialiased;
			}
			/* The site's topographic wash. Fixed element, not background-attachment,
			   which iOS Safari mishandles. */
			body::before {
				content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
				background: url("/home/Mask-1.webp") repeat; background-size: 1920px auto;
			}
			img { max-width: 100%; display: block; }
			h1, h2, h3 { margin: 0; font-family: Prompt, sans-serif; font-weight: 700; line-height: 1.12; letter-spacing: -0.01em; text-transform: uppercase; }
			p { margin: 0; }
			a { color: inherit; text-decoration: none; }
			ul { margin: 0; padding: 0; list-style: none; }
			.wrap { width: min(1200px, 100% - 32px); margin-inline: auto; }
			[id] { scroll-margin-top: 90px; }

			.btn {
				display: inline-flex; align-items: center; justify-content: center; gap: 8px;
				padding: 14px 30px; border-radius: 999px; font-size: 15px; font-weight: 600;
				border: 1.5px solid transparent; cursor: pointer; transition: 0.18s ease; white-space: nowrap;
			}
			.btn-gold { background: var(--gold); color: var(--ink); }
			.btn-gold:hover { background: var(--gold-deep); }
			.btn-outline { border-color: var(--gold); color: var(--ink); background: transparent; }
			.btn-outline:hover { background: var(--gold); }
			.btn-sm { padding: 10px 20px; font-size: 14px; }
			.btn-block { width: 100%; }
			.arw { font-size: 17px; line-height: 1; }

			.eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
			.eyebrow-muted { color: var(--muted); }

			.site-header { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 1px solid var(--line); }
			.header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 0; }
			.header-actions { display: flex; gap: 10px; }

			/* Hero: photograph, copy on the left, the form on the right. The form
			   is the page's one conversion, so it sits above the fold on desktop
			   and directly under the headline on a phone. */
			.hero { position: relative; overflow: hidden; color: #fff; }
			.hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
			.hero::after {
				content: ""; position: absolute; inset: 0;
				background: linear-gradient(90deg, rgba(18,20,22,0.78) 0%, rgba(18,20,22,0.5) 55%, rgba(18,20,22,0.35) 100%);
			}
			.hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; padding: 72px 0; min-height: min(760px, calc(100svh - 72px)); }
			.hero h1 { font-size: clamp(38px, 5.6vw, 68px); line-height: 1.02; margin-top: 14px; }
			.hero-sub { margin-top: 20px; max-width: 560px; font-size: clamp(17px, 1.8vw, 21px); line-height: 1.5; font-weight: 500; }
			.hero-checks { margin-top: 28px; display: grid; gap: 10px; }
			.hero-checks li { position: relative; padding-left: 30px; font-size: 17px; font-weight: 500; }
			.hero-checks li::before { content: "\2713"; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
			.form-card {
				background: var(--paper); color: var(--ink); border-radius: var(--r-lg);
				padding: 8px 18px 18px; box-shadow: 0 24px 60px rgba(0,0,0,0.35);
			}
			.form-note { font-size: 13px; color: var(--muted); text-align: center; margin-top: 4px; }

			.trust { background: var(--navy); color: #fff; }
			.trust-inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 40px; padding: 18px 0; font-size: 14px; font-weight: 500; }
			.trust b { color: var(--gold); }

			/* Problem and solution. The problem is small and muted, the answer is the
			   headline, because the answer is what the visitor came for. */
			.pairs { padding: 88px 0 24px; }
			.pairs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
			.pair { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 30px 26px; }
			.pair-problem { font-size: 15px; font-style: italic; color: var(--muted); padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--line); }
			.pair h2 { font-size: 22px; color: var(--navy); }
			.pair h2 + p { margin-top: 12px; font-size: 16px; line-height: 1.65; color: var(--muted); }

			.scene { padding: 72px 0; }
			.scene-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
			.scene-inner img { width: 100%; height: auto; border-radius: var(--r-lg); }
			.scene-copy h2 { font-size: clamp(28px, 3.6vw, 42px); margin: 12px 0 18px; color: var(--navy); }
			.scene-copy p:not(.eyebrow) { font-size: 17px; line-height: 1.7; color: var(--muted); max-width: 540px; }
			.scene-copy p + p { margin-top: 14px; }

			.section-title { font-size: clamp(26px, 3.2vw, 38px); text-align: center; color: var(--navy); }
			.section-lede { max-width: 620px; margin: 14px auto 0; text-align: center; color: var(--muted); font-size: 16px; }

			.paths { background: var(--bone); padding: 84px 0; }
			.paths-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 940px; margin: 40px auto 0; }
			.path-card { position: relative; display: flex; flex-direction: column; background: #fff; border: 2px solid #e7e2d9; border-radius: var(--r-lg); padding: 34px 30px 30px; }
			.path-card.is-featured { border: 3px solid var(--gold); padding-top: 38px; }
			.path-flag { position: absolute; top: -13px; left: 30px; background: var(--gold); font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 6px 14px; border-radius: 999px; }
			.path-kicker { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }
			.path-name { font-size: 26px; margin-top: 8px; color: #343434; }
			.path-timing { font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; margin: 10px 0 14px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
			.path-copy { color: #6f6b64; font-size: 15px; }
			.path-foot { margin-top: auto; padding-top: 26px; }
			.path-range-label { font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }
			.path-range { font-size: 20px; font-weight: 700; margin: 2px 0 20px; font-family: Prompt, sans-serif; }
			.paths-note { text-align: center; margin-top: 28px; font-size: 15px; color: #6f6b64; }

			.reviews { padding: 84px 0 24px; }
			.review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; align-items: start; }
			.review { margin: 0; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md); padding: 24px; }
			.stars { display: flex; gap: 3px; }
			.stars svg { fill: var(--gold-deep); }
			.review blockquote { margin: 12px 0 0; font-size: 16px; line-height: 1.6; }
			.review figcaption { margin-top: 14px; font-weight: 600; font-size: 14px; color: var(--navy); }

			.included { padding: 72px 0; }
			.included-inner { background: var(--soft); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(36px, 6vw, 64px) clamp(20px, 5vw, 56px); }
			.included-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 48px; margin-top: 36px; }
			.included-grid li { position: relative; padding-left: 30px; }
			.included-grid li::before { content: "\2713"; position: absolute; left: 0; top: 1px; color: var(--gold-deep); font-weight: 700; font-size: 17px; }
			.included-grid strong { display: block; color: var(--navy); }
			.included-grid span { display: block; font-size: 15px; color: var(--muted); }

			.faqs { padding: 24px 0 72px; }
			.faq-list { max-width: 820px; margin: 32px auto 0; }
			.faq { border-bottom: 1px solid var(--line); }
			.faq summary { cursor: pointer; list-style: none; position: relative; padding: 20px 36px 20px 0; font-family: Prompt, sans-serif; font-weight: 600; font-size: 18px; color: var(--navy); }
			.faq summary::-webkit-details-marker { display: none; }
			.faq summary::after { content: "+"; position: absolute; right: 4px; top: 16px; font-size: 24px; font-weight: 400; color: var(--gold-deep); }
			.faq[open] summary::after { content: "\2013"; }
			.faq p { padding-bottom: 22px; font-size: 16px; line-height: 1.7; color: var(--muted); max-width: 700px; }

			/* Closing band carries the site's topo panel; the footer's ridge rises
			   into its deep bottom padding, the way staging does it. */
			.close { position: relative; z-index: 1; }
			.close-inner {
				background: var(--soft) url("/home/CTA.webp") center / cover no-repeat; background-blend-mode: multiply;
				border: 1px solid var(--line); border-radius: var(--r-lg); text-align: center;
				padding: 88px 24px clamp(150px, 18vw, 250px);
				display: flex; flex-direction: column; align-items: center; gap: 14px;
			}
			.close-inner h2 { font-size: clamp(28px, 4vw, 46px); color: var(--navy); max-width: 820px; }
			.close-inner > p { color: var(--muted); font-size: 17px; max-width: 520px; }
			.close-inner .btn { margin-top: 10px; }
			.close-alt a { color: var(--navy); font-weight: 600; text-decoration: underline; }

			.site-footer {
				position: relative; z-index: 2; color: #fff; overflow: hidden;
				padding: 26vw 0 36px; margin-top: calc(-1 * clamp(120px, 15vw, 220px));
				background: linear-gradient(to bottom, transparent 24vw, var(--navy) 24vw);
			}
			.footer-art { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 100%; min-width: 1280px; pointer-events: none; }
			.footer-inner { position: relative; display: grid; justify-items: center; gap: 18px; text-align: center; }
			.footer-contact { display: grid; gap: 6px; font-size: 14px; color: rgba(255,255,255,0.8); }
