---
/*
 * Avatar 1, The Trailhead Regular. Tim's brief, 2026-09-24.
 * Ads A1-1 (trailhead) and A1-2 (gear garage) point here.
 *
 * Words to use: built around your gear, trailhead, garage, capable, days
 * without a hookup, spec. Never: luxury, vanlife, glamping, dream van,
 * adventure awaits.
 */
import AdLanding from "../components/AdLanding.astro";
---

<AdLanding
	slug="adventure"
	title="Wake Up At The Trailhead | Papago Vans"
	description="Custom camper vans on the Sprinter, Transit or ProMaster, built around your gear in Mesa, AZ. Van included."
	hero={{
		img: "/lp/scene-trailhead.webp",
		alt: "A couple at a trailhead beside their Sprinter, rear doors open on a made bed, packs and boots on the ground",
		eyebrow: "Custom camper vans · Mesa, AZ",
		h1: "Wake Up At The Trailhead",
		sub: "Take the life you already love farther, in a custom van built around your gear. Sprinter, Transit or ProMaster, made to order in Mesa, AZ.",
		checks: [
			"Locked gear garage under the bed",
			"Lithium power and diesel heat for days without a hookup",
			"Sprinter, Transit or ProMaster, van included",
		],
	}}
	pairs={[
		{
			problem: "The best campsite is at the trailhead. Your hotel isn't.",
			solution: "Your bedroom parks where the day starts.",
			body: "Coffee on the burner while it is still grey outside, first on the trail instead of forty minutes down the valley. Then do it again tomorrow somewhere new.",
		},
		{
			problem: "Your bike spends the night on a roof rack in a motel lot.",
			solution: "A locked gear garage under the bed.",
			body: "Bikes, skis, rods and wet gear ride inside, locked and drying. Tell us what you haul and we lay out the garage and the power around it.",
		},
		{
			problem: "The most common complaint from van owners? The electrical system.",
			solution: "Power for days out, wired in our own shop.",
			body: "A lithium bank, 400W or 600W of solar, charging while you drive, and an inverter for ordinary outlets. Wired in Mesa and covered by our 1-year craftsmanship warranty.",
		},
	]}
	photos={[
		{ img: "/lp/inside/adv-1.webp", alt: "A Ford Transit build seen through open rear doors: bed on top, gear garage below" },
		{ img: "/lp/inside/adv-2.webp", alt: "Papago's own control panel in a Ram ProMaster build: lights, battery monitor, inverter, water pump and hot water" },
		{ img: "/lp/inside/adv-3.webp", alt: "An induction cooktop in a butcher block counter, looking forward to the cab of a Ford Transit" },
		{ img: "/lp/inside/adv-4.webp", alt: "A turquoise galley and dinette running the length of a Sprinter, cab seats at the far end" },
		{ img: "/lp/inside/adv-5.webp", alt: "An L-shaped galley with undermount sink and induction cooktop behind the swivelled front seats" },
		{ img: "/lp/inside/adv-6.webp", alt: "A stainless sink and two-burner stove in a wood counter, window open on the water" },
		{ img: "/lp/inside/adv-7.webp", alt: "A galley with a pull-down faucet, induction cooktop and wall-mounted TV" },
		{ img: "/lp/inside/adv-8.webp", alt: "A Sprinter's rear doors open on a bed platform over the garage" },
	]}
	reviews={[
		{ name: "Michael V.", quote: "Great van conversion place. Veteran owned. Quality service, and they build things to last." },
		{ name: "Nai S.", quote: "The team truly listened to my needs and made them a reality. From a custom book shelf to smaller detailed preferences, these guys really honored my dreams from start to finish." },
		{ name: "Brian L.", quote: "There are a handful of van conversion companies in the Phoenix area but Papago is unique. If I ever plan to do another van conversion, I can't imagine doing it anywhere else." },
	]}
	included={{
		h2: "What You Can Spec",
		items: [
			["Lithium power and solar", "400W or 600W on the roof, charging while you drive"],
			["Diesel heat and air conditioning", "Warm at the ski lot, cool in the desert"],
			["Gear garage", "Under the bed, locked, laid out around what you haul"],
			["Hot water and a shower", "Exterior shower on any build; indoor in most floor plans"],
			["Wheels, tires and suspension", "All-terrain packages spec'd on day one, not bolted on later"],
			["Roof rack, ladder and awning", "Room for gear up top, shade when you need it"],
			["A real kitchen", "Butcher block counter, induction cooktop option"],
			["Havelock wool insulation", "Handles moisture better than foam, from Phoenix heat to 20 degrees"],
			["The van itself", "Sprinter, Transit or ProMaster, included in the price"],
			["RVIA certified", "The standard lenders, insurers and campgrounds look for"],
			["1-year craftsmanship warranty", "On everything we build"],
			["Veteran owned", "Built by people who show up"],
		],
	}}
	faqs={[
		{ q: "How long can I stay out without a hookup?", a: "Days rather than hours, and that is most of what the electrical spec buys you. Lithium batteries, 400W or 600W of solar and a diesel heater set the number. The exact figure depends on the weather and whether you are running air conditioning." },
		{ q: "How does the electrical system work?", a: "Solar charges a lithium bank, the van runs at 12V off that bank, and an inverter makes 110V for ordinary household outlets. It also charges while you drive. An RV has to be plugged in; this does not." },
		{ q: "What if my gear does not fit a floor plan?", a: "That is what Bespoke is for. It starts from an empty van and a designer, so the van gets drawn around the motorcycle, the raft or the dogs." },
		{ q: "How much does it cost?", a: "A Tailored build runs $180,000 to $250,000 and Bespoke $250,000 to $350,000. Both include the van. Most of the range is chassis length and how much power, water and off-road equipment you specify." },
		{ q: "Which vans do you build on?", a: "The Mercedes-Benz Sprinter, the Ford Transit and the Ram ProMaster. Whichever you choose, the price includes the van." },
		{ q: "Can I finance it?", a: "Yes, through our partner Hearth. We can finance the van and the build together, or the build on its own." },
	]}
	close={{
		h2: "Tell Us What You Ride",
		p: "We will design the van around it and put a real number on it, van included.",
	}}
/>
