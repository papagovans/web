---
const CTA = "Start Your Free Build Quote";
const LOGO = "https://papagovans.com/wp-content/uploads/2023/06/papagovans.png";
const HERO_BG = "https://papagovans.com/wp-content/uploads/2025/07/papago_vans.webp";
const PROBLEM_IMG = "https://papagovans.com/wp-content/uploads/2023/06/DSC_0260-1-min.jpg";
const BENEFIT_IMGS = [
	"https://papagovans.com/wp-content/uploads/2025/08/JMO_0164-scaled.jpg",
	"https://papagovans.com/wp-content/uploads/2025/08/2025-07-21-10-scaled.jpg",
	"https://papagovans.com/wp-content/uploads/2025/08/JMO_1978-scaled.jpg",
];

const faqs = [
	{
		q: "How much does a custom camper van cost?",
		a: "It depends on the build tier and options you choose. Our top-tier El Capitan starts at $127,395 (van not included); most builds land well below that. Tell us your budget and we'll show you which tier fits.",
	},
	{
		q: "Do I need to bring my own van?",
		a: "Yes — the van itself isn't included in the build price. We can also help you source the right Sprinter, Transit, or Promaster before we start the conversion.",
	},
	{
		q: "Can I finance my build?",
		a: "Yes. We offer financing through Hearth, so you don't have to pay for the full build up front.",
	},
	{
		q: "What's the difference between the build tiers?",
		a: "Our five tiers (El Capitan, Olympus, Zion, Mammoth, Rainier) range from fully custom, no-limits builds to curated packages with set options. Every tier still gets off-grid power, water, and climate control.",
	},
	{
		q: "Is Papago Vans actually certified?",
		a: "Yes — we're RVIA-certified and veteran-owned. RVIA certification matters for insurance and for getting into campgrounds that require it.",
	},
	{
		q: "How long does a build take?",
		a: "Timelines depend on the tier and our current shop schedule. Tell us your ideal timeline in the quote form and we'll give you a real estimate, not a guess.",
	},
];

const features = [
	["Off-grid solar power system", "Keep every system running with zero hookups"],
	["Lithium-ion battery bank", "Enough capacity for days off the grid"],
	["Indoor shower", "Rinse off without leaving the van"],
	["Full kitchen", "Acacia butcher block counter, induction cooktop option"],
	["Hot & cold running water", "Undermount sink, real plumbing"],
	["Heating and air conditioning", "Comfortable in the desert or the mountains"],
	["Premium custom cabinetry", "Built to fit your layout, not a template"],
	["Roof racks, ladders & awnings", "Room for gear, shade when you need it"],
	["Adventure-ready storage", "A place for everything, nothing rattling around"],
	["5 signature build tiers", "From curated packages to fully custom"],
	["Fully custom layout", "No two Papago vans are alike"],
	["Veteran-owned & operated", "Built by people who show up"],
	["RVIA-certified construction", "Meets the standard insurers and campgrounds look for"],
	["Financing available", "Through our partner, Hearth"],
	["Sprinter, Transit, or Promaster", "We build on the platform you already trust"],
	["Made to order in Mesa, AZ", "Every van built in-house, start to finish"],
];

const testimonials = [
	{
		quote:
			"There is absolutely no way that we could have found a better company to build out our custom dream van to “see the USA”. Hands down, they’re the best in the business.",
		name: "Mike and Melanie",
	},
	{
		quote:
			"We have been 100% happy right from our beginning inquiry phone call to waving good-by as we drove our newly finished custom van out the driveway.",
		name: "Wendy F.",
	},
	{
		quote:
			"They went above and beyond my wildest dreams and created an absolutely stunning van for me! I encourage anyone considering a build to reach out to Papago Vans.",
		name: "Debi L.",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Never Pay For A Hotel Room Again | Papago Vans</title>
		<meta
			name="description"
			content="Custom Sprinter, Transit, and Promaster camper van conversions built in Mesa, AZ. Veteran-owned, RVIA-certified, financing available."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- TEMP: CTA buttons scroll to #quote, which currently shows phone/email as a stand-in
		     until the HubSpot form is designed and embedded there. -->

		<header class="site-header">
			<div class="wrap header-inner">
				<a href="/" class="logo"><img src={LOGO} alt="Papago Vans" /></a>
				<a href="tel:+14807617175" class="phone">
					<span class="phone-label">Call Us</span>
					<span class="phone-number">(480) 761-7175</span>
				</a>
			</div>
		</header>

		<section class="hero" style={`background-image: linear-gradient(180deg, rgba(30,38,46,.55), rgba(20,26,32,.8)), url(${HERO_BG})`}>
			<div class="wrap hero-grid">
				<div class="hero-copy">
					<h1>Never Pay For A Hotel Room Again</h1>
					<p class="subhead">
						A custom Papago Vans conversion turns your Sprinter, Transit, or Promaster into
						off-grid lodging you already own &mdash; built to order in Mesa, AZ.
					</p>
					<ul class="checks">
						<li>&#10003; Off-grid power, water &amp; climate control built in</li>
						<li>&#10003; Veteran-owned, RVIA-certified craftsmanship</li>
						<li>&#10003; Financing available, 5 build tiers to fit any budget</li>
					</ul>
					<p class="hero-body">
						Every trip you take in a hotel or an Airbnb is money spent and gone. A Papago
						van is money spent once &mdash; then it's yours every time you hit the road,
						built around exactly how you travel.
					</p>
				</div>
				<div class="hero-form" id="quote">
					<div class="form-card">
						<h2>Get Your Free Build Quote</h2>
						<p>Tell us about your build and we'll follow up within one business day.</p>
						<div class="form-placeholder">
							<p>HubSpot form goes here</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="problem wrap">
			<div class="problem-media">
				<img src={PROBLEM_IMG} alt="Custom Papago Vans camper conversion" loading="lazy" />
			</div>
			<div class="problem-copy">
				<p class="lede">
					Every night in a hotel is money you will never see again.
				</p>
				<p>
					<strong>Multiply that out.</strong> A week-long trip runs $1,000&ndash;$2,000 in
					lodging alone, and you still don't get to stay where you actually want to be &mdash;
					you're stuck near a highway exit, checking out at 11am, packing the car every
					morning instead of watching the sunrise.
				</p>
				<p>
					<strong>Papago Vans turns that spend into an asset.</strong> A fully custom camper
					conversion means your bed, kitchen, shower, and power system travel with you.
					Pull over wherever the view is best. No checkout time. No nightly rate.
				</p>
			</div>
		</section>

		<section id="benefits" class="benefits">
			<div class="wrap">
				<h2>Why Owners Switch To A Papago Van</h2>
				<div class="cards">
					<div class="card">
						<img src={BENEFIT_IMGS[0]} alt="" loading="lazy" />
						<h3>Stop Paying For Lodging</h3>
						<p>Full off-grid power, water, and climate systems built into every van.</p>
					</div>
					<div class="card">
						<img src={BENEFIT_IMGS[1]} alt="" loading="lazy" />
						<h3>Go Anywhere, Stay Anywhere</h3>
						<p>Solar, lithium power, and off-road packages built for real distance.</p>
					</div>
					<div class="card">
						<img src={BENEFIT_IMGS[2]} alt="" loading="lazy" />
						<h3>Built Around Your Life</h3>
						<p>5 signature build tiers, fully custom layouts, made to order in Mesa, AZ.</p>
					</div>
				</div>
			</div>
		</section>

		<section id="reviews" class="testimonials">
			<div class="wrap">
				<h2>What Owners Say</h2>
				<div class="cards">
					{testimonials.map((t) => (
						<div class="quote-card">
							<p class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
							<p class="quote">&ldquo;{t.quote}&rdquo;</p>
							<p class="name">&mdash; {t.name}</p>
						</div>
					))}
				</div>
				<p class="review-line">4.7&#9733; from 70+ verified customer reviews</p>
			</div>
		</section>

		<section id="features" class="features">
			<div class="wrap">
				<h2>Every Build Includes</h2>
				<div class="feature-grid">
					{features.map(([name, desc]) => (
						<div class="feature">
							<span class="check">&#10003;</span>
							<div>
								<strong>{name}</strong>
								<p>{desc}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="faq" class="faq">
			<div class="wrap">
				<h2>Questions, Answered</h2>
				<div class="faq-list">
					{faqs.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="final-cta">
			<div class="wrap">
				<h2>Ready to stop paying for hotels?</h2>
				<a href="#quote" class="btn btn-primary">{CTA}</a>
				<p class="fallback">
					Or call <a href="tel:+14807617175">(480) 761-7175</a> / email
					<a href="mailto:info@papagovans.com">info@papagovans.com</a>
				</p>
			</div>
		</section>

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<div class="footer-brand">
					<img src={LOGO} alt="Papago Vans" />
					<p>Custom camper van conversions, built to order in Mesa, AZ.</p>
					<p>(480) 761-7175 &middot; info@papagovans.com</p>
					<p>751 N Country Club Dr, Mesa, AZ 85201</p>
				</div>
				<div class="footer-links">
					<a href="#benefits">Why Papago</a>
					<a href="#features">Features</a>
					<a href="#reviews">Reviews</a>
					<a href="#faq">FAQ</a>
					<a href="#quote">{CTA}</a>
				</div>
			</div>
			<div class="copyright wrap">&copy; {new Date().getFullYear()} All rights reserved | Papago Vans</div>
		</footer>

		<style>
			:root {
				--navy: #303c47;
				--charcoal: #414042;
				--steel: #53687b;
				--sky: #6c93b7;
				--gold: #f4d969;
				--cream: #fcfaf3;
				--offwhite: #f5f5f5;
			}
			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body {
				margin: 0;
				font-family: "Prompt", sans-serif;
				color: var(--charcoal);
				background: #fff;
			}
			h1, h2, h3 { font-weight: 800; margin: 0 0 .5em; text-transform: uppercase; letter-spacing: .01em; }
			p { line-height: 1.6; }
			.wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

			.btn {
				display: inline-block;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: .05em;
				text-decoration: none;
				padding: 16px 32px;
				border-radius: 4px;
				font-size: 15px;
			}
			.btn-primary { background: var(--gold); color: var(--navy); }
			.btn-primary:hover { background: #efc945; }
			.btn-ghost { color: #fff; border: 2px solid #fff; padding: 10px 20px; font-size: 13px; }
			.btn-ghost:hover { background: rgba(255,255,255,.15); }

			.site-header {
				position: sticky; top: 0; z-index: 10;
				background: var(--navy);
			}
			.header-inner {
				display: flex; align-items: center; justify-content: space-between;
				padding-top: 14px; padding-bottom: 14px;
			}
			.logo img { height: 40px; display: block; }
			.phone { text-decoration: none; text-align: right; line-height: 1.2; }
			.phone-label {
				display: block; color: var(--gold); font-size: 11px; font-weight: 700;
				text-transform: uppercase; letter-spacing: .08em;
			}
			.phone-number { display: block; color: #fff; font-size: 19px; font-weight: 700; }

			.hero {
				background-size: cover; background-position: center;
				padding: 70px 0 100px;
				color: #fff;
			}
			.hero-grid {
				display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: start;
			}
			.hero-copy { padding-top: 40px; }
			.hero h1 { font-size: clamp(34px, 4.2vw, 52px); line-height: 1.05; margin-bottom: .4em; }
			.subhead { font-size: 18px; color: #e9edf1; margin-bottom: 24px; }
			.checks { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 10px; }
			.checks li { font-size: 15px; }
			.hero-body { font-size: 15px; color: #d3d9de; max-width: 46ch; }

			.hero-form { padding-top: 8px; }
			.form-card {
				background: var(--cream); border-radius: 10px; padding: 32px;
				box-shadow: 0 20px 50px rgba(0,0,0,.35); color: var(--charcoal);
			}
			.form-card h2 { font-size: 22px; color: var(--navy); margin-bottom: .3em; }
			.form-card > p { font-size: 14px; color: var(--steel); margin: 0 0 20px; }
			.form-placeholder {
				border: 2px dashed #c9c2ab; border-radius: 8px; padding: 60px 16px;
				text-align: center; color: var(--steel); font-size: 14px; font-weight: 600;
			}
			@media (max-width: 860px) {
				.hero-grid { grid-template-columns: 1fr; }
				.hero-copy { padding-top: 0; }
			}

			.problem {
				display: grid; grid-template-columns: 1fr 1fr; gap: 56px;
				align-items: center; padding: 90px 24px;
			}
			.problem-media img { width: 100%; border-radius: 8px; display: block; }
			.lede { font-size: 26px; font-weight: 700; color: var(--navy); line-height: 1.3; }
			@media (max-width: 860px) { .problem { grid-template-columns: 1fr; padding: 60px 24px; } }

			.benefits, .testimonials, .features, .faq { padding: 90px 0; }
			.benefits { background: var(--cream); }
			.benefits h2, .testimonials h2, .features h2, .faq h2 {
				text-align: center; font-size: 32px; margin-bottom: 48px; color: var(--navy);
			}
			.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
			@media (max-width: 860px) { .cards { grid-template-columns: 1fr; } }
			.card { text-align: center; }
			.card img { width: 100%; height: 180px; object-fit: cover; border-radius: 8px; margin-bottom: 18px; }
			.card h3 { color: var(--navy); font-size: 20px; }

			.testimonials { background: #fff; }
			.quote-card {
				background: var(--offwhite); border-radius: 8px; padding: 28px;
				display: flex; flex-direction: column; gap: 12px;
			}
			.stars { color: var(--gold); letter-spacing: 2px; margin: 0; }
			.quote { font-size: 15px; color: var(--charcoal); flex-grow: 1; }
			.name { font-weight: 600; color: var(--steel); margin: 0; }
			.review-line { text-align: center; margin-top: 36px; font-weight: 600; color: var(--navy); font-size: 17px; }

			.features { background: var(--navy); color: #fff; }
			.features h2 { color: #fff; }
			.feature-grid {
				display: grid; grid-template-columns: 1fr 1fr; gap: 20px 48px;
			}
			@media (max-width: 700px) { .feature-grid { grid-template-columns: 1fr; } }
			.feature { display: flex; gap: 14px; align-items: flex-start; }
			.check { color: var(--gold); font-weight: 800; font-size: 18px; line-height: 1.4; }
			.feature strong { display: block; font-size: 16px; }
			.feature p { margin: 2px 0 0; font-size: 14px; color: #c7d0d8; }

			.faq-list { max-width: 760px; margin: 0 auto; }
			details {
				border-bottom: 1px solid #e2e2e2; padding: 18px 0;
			}
			summary {
				cursor: pointer; font-weight: 600; font-size: 17px; color: var(--navy);
				list-style: none; position: relative; padding-right: 28px;
			}
			summary::-webkit-details-marker { display: none; }
			summary::after {
				content: "+"; position: absolute; right: 0; top: 0; font-size: 22px; color: var(--steel);
			}
			details[open] summary::after { content: "\2212"; }
			details p { margin: 14px 0 0; color: var(--charcoal); font-size: 15px; }

			.final-cta {
				background: var(--gold);
				text-align: center;
				padding: 80px 0;
			}
			.final-cta h2 { color: var(--navy); font-size: 34px; }
			.final-cta .btn-primary { background: var(--navy); color: #fff; }
			.final-cta .btn-primary:hover { background: #253038; }
			.final-cta .fallback { margin-top: 18px; font-size: 14px; color: var(--charcoal); }
			.final-cta .fallback a { color: var(--navy); font-weight: 600; }

			.site-footer { background: var(--charcoal); color: #d8d8d8; padding-top: 56px; }
			.footer-inner {
				display: flex; justify-content: space-between; gap: 40px; flex-wrap: wrap;
				padding-bottom: 40px;
			}
			.footer-brand img { height: 34px; margin-bottom: 12px; }
			.footer-brand p { font-size: 14px; margin: 4px 0; color: #b7b7b7; }
			.footer-links { display: flex; flex-direction: column; gap: 10px; }
			.footer-links a { color: #d8d8d8; text-decoration: none; font-size: 14px; }
			.footer-links a:hover { color: var(--gold); }
			.copyright {
				border-top: 1px solid rgba(255,255,255,.1);
				padding: 18px 24px; font-size: 13px; color: #999;
			}
		</style>
	</body>
</html>
