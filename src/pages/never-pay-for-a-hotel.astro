---
/*
 * Base ad page: the general audience, before an avatar is known.
 * Copy and facts rules live in AdLanding.astro.
 */
import AdLanding from "../components/AdLanding.astro";
---

<AdLanding
	slug="base"
	title="Never Pay For A Hotel Room Again | Papago Vans"
	description="Custom Mercedes-Benz Sprinter camper vans, built to order in Mesa, AZ. Van included in every price. Veteran owned, RVIA certified."
	hero={{
		img: "/lp/hero-lg.webp",
		alt: "A Papago Vans Sprinter with its pop-top raised at a pine forest campsite, a family around the fire at dusk",
		eyebrow: "Custom Sprinter camper vans · Mesa, AZ",
		h1: "Never Pay For A Hotel Room Again",
		sub: "Your bed, your kitchen and your shower, parked wherever you stopped. Built to order in Mesa, Arizona, with the Mercedes-Benz Sprinter included in the price.",
		checks: [
			"Power, water, heat and air built in",
			"Veteran owned and RVIA certified",
			"4.7 stars from 70+ verified reviews",
		],
	}}
	pairs={[
		{
			problem: "The hotel is never where you actually wanted to be.",
			solution: "Your bed parks where the view is.",
			body: "Hotels sit by the highway exit, checkout is at 11, and the car gets repacked every morning. A Papago goes where you were headed and stays as long as you like.",
		},
		{
			problem: "Production vans are built for the average buyer.",
			solution: "Yours is built around how you travel.",
			body: "Pick one of five floor plans we have built dozens of times, then decide every system in it: power, water, heat, kitchen, storage and finishes.",
		},
		{
			problem: "The quote was not the price.",
			solution: "Our price includes the van.",
			body: "A Tailored build runs $180,000 to $250,000 with the Sprinter included. Most of that range is chassis length and how much power, water and off-road equipment you choose.",
		},
	]}
	scene={{
		img: "/lp/collage-feature.webp",
		alt: "Three children eating breakfast at the dinette of a Papago van, back doors open onto pine forest",
		eyebrow: "Everyone Fits",
		h2: "Breakfast Wherever You Woke Up",
		paras: [
			"Two to six people depending on the floor plan, the chassis length and whether you add a pop-top. Nobody draws the short straw and sleeps on a hotel rollaway.",
			"Lithium power and solar keep the lights, the water pump and the heat running without a hookup, and it charges while you drive. Pull over where the view is best. No checkout time. No nightly rate.",
		],
	}}
	reviews={[
		{ name: "Mike and Melanie", quote: "There is absolutely no way that we could have found a better company to build out our custom dream van to see the USA. Hands down, they're the best in the business." },
		{ name: "Danielle M.", quote: "They created my custom camper van better than I even imagined. The attention to detail and the little things meant the most!" },
		{ name: "Nicole P.", quote: "They listened to my wants and needs and helped me every step of the way to design my campervan exactly how I wanted it." },
	]}
	included={{
		h2: "What Goes Into A Papago",
		items: [
			["Lithium power and solar", "400W or 600W on the roof, and it charges while you drive"],
			["Heat and air conditioning", "Comfortable in the desert or the mountains"],
			["Hot and cold running water", "Undermount sink, real plumbing"],
			["A real kitchen", "Acacia butcher block counter, induction cooktop option"],
			["Shower options", "Exterior shower on any build; indoor shower and toilet in most floor plans"],
			["Custom cabinetry", "Built in our Mesa shop to fit your layout"],
			["Your finishes", "Flooring, walls, cabinets and countertop from in-stock swatches"],
			["The Sprinter itself", "Sourced through dealers we already work with, included in the price"],
			["RVIA certified", "The standard lenders, insurers and campgrounds look for"],
			["1-year craftsmanship warranty", "We stand behind what we build"],
			["Financing available", "The van and the build together, or the build on its own"],
			["Veteran owned", "Built by people who show up"],
		],
	}}
	faqs={[
		{ q: "How much does a Papago van cost?", a: "A Tailored build runs $180,000 to $250,000 and a Bespoke build $200,000 to $300,000. Both include the Mercedes-Benz Sprinter. Most of the range is chassis length and how much power, water and off-road equipment you specify." },
		{ q: "Do I need to bring my own van?", a: "No. We source it through dealerships we already work with, and the price includes it. If you already own a Sprinter, bring it and we will price the build on its own." },
		{ q: "Can I have a bathroom and a shower inside?", a: "Yes. An enclosed indoor shower and toilet fit in most of our floor plans, and every build can carry an exterior shower as well." },
		{ q: "Can I finance my build?", a: "Yes, through our partner Hearth. We can finance the van and the build together, or the build on its own." },
		{ q: "Why does RVIA certification matter?", a: "Lenders and insurers treat a certified conversion as an RV rather than a modified cargo van, which is what makes RV-term lending and proper coverage available. Many campgrounds require it too." },
		{ q: "How many people can it sleep?", a: "Two to six, depending on the floor plan, the chassis length and whether you add a pop-top." },
	]}
	close={{
		h2: "Ready To Stop Paying For Hotels?",
		p: "Tell us how you travel. We will put a real number on your van, Sprinter included.",
	}}
/>
