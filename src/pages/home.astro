---
/*
 * Home page mockup for go.papagovans.com/home
 *
 * A rebuild of the new homepage the agency has on staging at
 * papagovansdev.wpenginepowered.com, so Papago can iterate on it without
 * waiting on the agency. Type, palette and layout are copied from the live
 * staging DOM rather than eyeballed:
 *
 *   Prompt          typeface, same as the build configurator
 *   #F4D969         gold, primary action
 *   #414042         body copy
 *   #69727D         muted copy
 *   #6C93B7         blue band behind "The Papago"
 *   #303C47         footer navy, the value Frame-66.svg paints its ridges with,
 *                   and the same navy the build configurator already uses
 *
 * Three deliberate differences from staging:
 *   1. The hero is a still rather than the video loop.
 *   2. A "Build Your Van One of Three Ways" section sits under the stats,
 *      splitting buyers between Signature, Tailored and Bespoke.
 *   3. A "Build Your Van" band sits below that, pointing at
 *      build.papagovans.com. Neither exists on staging.
 *
 * Every nav and card link is href="#" on purpose. This is a mockup.
 */

const PHONE = "+1 602-346-0331";
const BUILD_APP = "https://build.papagovans.com";

const stats = [
	{ icon: "Group-293.svg", value: "33", unit: "GA", label: "Fresh Water" },
	{ icon: "Group-297.svg", value: "800", unit: "AH", label: "Lithium ION Battery" },
	{ icon: "Group-310.svg", value: "300", unit: "W", label: "Solar System" },
	{ icon: "Group-291.svg", value: "12", unit: "V", label: "AC Unit" },
	{ icon: "Group-313.svg", value: "100", unit: "%", label: "Custom Built" },
];

const builds = [
	{
		name: "El Capitan",
		price: "Starts at $127,395+",
		img: "image-1-4.webp",
		copy: "This is our top-tier luxury build, featuring premium finishes, custom upgrades, and adventure-ready options. Its spacious, flexible layout is perfect for families or larger groups who want to travel without limits.",
		specs: ["2-6", "920Ah", "Yes", "33G"],
	},
	{
		name: "Build Layout 4",
		price: "Starts at $86,795",
		img: "JMO_1216.webp",
		copy: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
		specs: ["2-6", "460Ah", "Yes", "33G"],
	},
	{
		name: "Build Layout 3",
		price: "Starts at $108,595",
		img: "image-5.webp",
		copy: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
		specs: ["2-6", "920Ah", "Yes", "33G"],
	},
];

/*
 * Three ways to buy. The ladder is deliberate: each step down trades speed for
 * control, and the price range rises with it, so the order reads as a decision
 * rather than a menu. "Tailored" is the name for the configurator tier; it sits
 * between Signature (fixed) and Bespoke (from scratch) in both senses.
 */
const paths = [
	{
		name: "Signature Pre-Build",
		kicker: "Fastest to the road",
		copy: "Layouts we designed ourselves after years of building vans, then refined over and over. Floor plan and cabinetry are set, which is exactly why they cost less and ship soonest. Pick your finishes and go.",
		range: "$180,000 &ndash; $240,000",
		cta: "Explore Signature Builds",
		href: "#",
		featured: false,
	},
	{
		name: "Tailored",
		kicker: "Build your van online",
		copy: "Start from a signature floor plan and configure every system yourself: power, water, heat, kitchen, storage, finishes. Watch the price move as you go, then download your Build Sheet. Second fastest way to get your van.",
		range: "$190,000 &ndash; $250,000",
		cta: "Start Building",
		href: BUILD_APP,
		featured: true,
	},
	{
		name: "Bespoke",
		kicker: "Built from scratch",
		copy: "A blank van and a designer. Your layout, your cabinetry, your ideas. Nearly anything is on the table. It costs more and takes 9 to 12 months, and for the right owner it is worth every week of it.",
		range: "$200,000 &ndash; $300,000",
		cta: "Talk to a Designer",
		href: "#",
		featured: false,
	},
];

const steps = [
	{
		n: "1",
		img: "image-2.webp",
		title: "Choose Your Layout",
		copy: "Browse your signature models and pick a layout that fits your lifestyle.",
	},
	{
		n: "2",
		img: "image-4.webp",
		title: "Customize Your Build",
		copy: "Select your base chassis and personalize everything from power systems to storage and upgrades.",
	},
	{
		n: "3",
		img: "image-2-2.webp",
		title: "We Build, You Travel",
		copy: "Our expert team builds your van with precision, updating you at every stage until delivery day.",
	},
];

const gallery = [
	{ img: "Papago-Sprinter-Camper-Van-Completed-Build-11-768x512.jpeg", name: "The Northrop Van" },
	{ img: "On-the-Brink-Van-3-Large-768x512.jpeg", name: "The Brinkman Van" },
	{ img: "Sweeney-Van-Final-Shots-1-Large-768x512.jpeg", name: "The Cherry Van" },
	{ img: "Papago-Sprinter-Camper-Van-Complete-170-3500-17-Large-768x512.jpeg", name: "The Turner Van" },
];

const footerCols = [
	{ h: "Campers", links: ["El Capitan", "Olympus", "Four Peaks", "Rainier"] },
	{ h: "Resources", links: ["About Us", "News", "FAQ", "Financing"] },
	{ h: "Services", links: ["Interior Installation", "Exterior Upgrades", "Heating and cooling", "Partial Build"] },
	{ h: "Policies", links: ["Terms & Conditions", "Privacy Policy", "CCPA"] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Arizona Campervan Conversions | Custom Vans by Papago</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- Header -->
		<header class="site-header">
			<div class="wrap header-inner">
				<a href="#" class="logo" aria-label="Papago Vans home">
					<img src="/home/Group-278.svg" alt="Papago Vans" width="174" height="27" />
				</a>
				<nav class="main-nav" aria-label="Main">
					<a href="#">View Models</a>
					<a href="#">Let&rsquo;s Get Started</a>
					<a href="#">View Recent Builds</a>
				</nav>
				<div class="header-actions">
					<a href="#" class="btn btn-outline btn-sm">Call Now: {PHONE}</a>
					<button class="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
				</div>
			</div>
		</header>

		<!-- Hero. Staging runs a video loop here; a still stands in for the mockup. -->
		<section class="hero">
			<div class="hero-media">
				<img src="/home/On-the-Brink-Van-9-Large.jpeg" alt="A Papago Vans Sprinter conversion parked on desert flats below the Four Peaks" />
			</div>
			<div class="wrap hero-inner">
				<div class="hero-copy">
					<h1>Camper Vans Built<br />To Explore</h1>
					<p>
						From weekend escapes to full-range adventures, Papago Vans delivers rugged,
						high-performance conversions ready for any terrain.
					</p>
				</div>
				<div class="hero-ctas">
					<a href="#" class="btn btn-outline">View Models</a>
					<a href="#" class="btn btn-gold">Get Started <span class="arw">&#8853;</span></a>
				</div>
			</div>
		</section>

		<!-- Stats -->
		<section class="stats">
			<div class="wrap stats-inner">
				{stats.map((s) => (
					<div class="stat">
						<img src={`/home/${s.icon}`} alt="" width="40" height="40" />
						<p class="stat-value">{s.value}<span>{s.unit}</span></p>
						<p class="stat-label">{s.label}</p>
					</div>
				))}
			</div>
		</section>

		<!-- NEW: three ways to buy. Not on staging. -->
		<section class="paths">
			<div class="wrap">
				<h2 class="section-title">Build Your Van One of Three Ways</h2>
				<p class="section-lede">
					Every Papago is built by hand in Mesa, Arizona. The only question is how much
					of it you want to decide. Every price includes the Mercedes-Benz Sprinter.
				</p>
				<div class="paths-grid">
					{paths.map((p) => (
						<article class={p.featured ? "path-card is-featured" : "path-card"}>
							{p.featured && <span class="path-flag">Most Popular</span>}
							<p class="path-kicker">{p.kicker}</p>
							<h3 class="path-name">{p.name}</h3>
							<p class="path-copy">{p.copy}</p>
							<div class="path-foot">
								<p class="path-range-label">Pricing Range</p>
								<p class="path-range" set:html={p.range} />
								<a href={p.href} class={p.featured ? "btn btn-gold btn-block" : "btn btn-outline btn-block"}>
									{p.cta} <span class="arw">&#8853;</span>
								</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- NEW: build configurator band. Not on staging. -->
		<section class="buildapp">
			<div class="wrap buildapp-inner">
				<div class="buildapp-copy">
					<p class="eyebrow">New</p>
					<h2>Build Your Van Online</h2>
					<p>
						Pick a floor plan, choose a trim package, and customize every system with a
						running price. Download your Build Sheet when you&rsquo;re done. Every price
						includes the Mercedes-Benz Sprinter.
					</p>
					<a href={BUILD_APP} class="btn btn-gold">Start Building <span class="arw">&#8853;</span></a>
				</div>
				<div class="buildapp-art">
					<img src="/home/Northrop-Sprinter-144-Final-Pics-30-Large.jpeg" alt="Papago Vans Sprinter conversion in the Arizona desert" />
				</div>
			</div>
		</section>

		<!-- Signature builds -->
		<section class="builds">
			<div class="wrap">
				<h2 class="section-title">Explore Our Signature Builds</h2>
				<p class="section-lede">
					Each layout is crafted with precision for different travel lifestyles. Whether
					you&rsquo;re off-roading, remote working, or traveling with your dog &mdash; we have a
					van for that.
				</p>
			</div>
			<div class="wrap builds-rail">
				<button class="rail-btn rail-prev" aria-label="Previous">&#8249;</button>
				<div class="builds-grid">
					{builds.map((b) => (
						<article class="build-card">
							<div class="build-img"><img src={`/home/${b.img}`} alt={b.name} /></div>
							<div class="build-body">
								<div class="build-head">
									<h3>{b.name}</h3>
									<span class="price-pill">{b.price}</span>
								</div>
								<p class="build-copy">{b.copy}</p>
								<div class="build-specs">
									{b.specs.map((sp) => (
										<div class="spec"><img src="/home/Group-280.svg" alt="" width="18" height="18" /><span>{sp}</span></div>
									))}
								</div>
								<a href="#" class="btn btn-outline btn-block">Explore <span class="arw">&#8853;</span></a>
							</div>
						</article>
					))}
				</div>
				<button class="rail-btn rail-next" aria-label="Next">&#8250;</button>
			</div>
		</section>

		<!-- The Papago -->
		<section class="papago">
			<div class="wrap papago-inner">
				<div class="papago-img">
					<img src="/home/papago-model.jpeg" alt="The Papago van model parked on a desert road" />
				</div>
				<div class="papago-card">
					<h2>The Papago</h2>
					<p>
						Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem
						Ipsum has been the industry&rsquo;s standard dummy text ever since the 1500s,
					</p>
					<div class="papago-specs">
						{["2-6", "800Ah", "33G"].map((sp) => (
							<div class="spec"><img src="/home/Group-280.svg" alt="" width="18" height="18" /><span>{sp}</span></div>
						))}
					</div>
					<a href="#" class="btn btn-gold">Book A Call With Us <span class="arw">&#8853;</span></a>
				</div>
			</div>
		</section>

		<!-- Process -->
		<section class="process">
			<div class="wrap process-inner">
				<div class="process-head">
					<h2>How Your Dream<br />Van Comes To Life</h2>
					<p>
						At Papago Vans, we make the process simple, smooth, and actually enjoyable from
						first call to final keys.
					</p>
				</div>
				<div class="process-steps">
					{steps.map((s) => (
						<div class="step-row">
							<div class="step-img"><img src={`/home/${s.img}`} alt="" /></div>
							<div class="step-card">
								<span class="step-num">{s.n}</span>
								<div>
									<h3>{s.title}</h3>
									<p>{s.copy}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Platforms -->
		<section class="platforms">
			<div class="wrap">
				<h2 class="section-title">Van Platforms We Work With</h2>
				<p class="section-lede">
					We work with the most trusted vans on the market and guide you through choosing
					(or sourcing) the right one for your build.
				</p>
				<div class="platform-logos">
					<span class="plat plat-mb" aria-label="Mercedes-Benz">
						<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="none" stroke="#414042" stroke-width="3"/><path d="M32 32 32 5 M32 32 8.5 46 M32 32 55.5 46" stroke="#414042" stroke-width="3" fill="none"/></svg>
						<em>Mercedes-Benz</em>
					</span>
					<span class="plat plat-ford" aria-label="Ford">
						<svg viewBox="0 0 160 64" aria-hidden="true"><ellipse cx="80" cy="32" rx="78" ry="30" fill="#1B4C9B"/><ellipse cx="80" cy="32" rx="73" ry="26" fill="none" stroke="#fff" stroke-width="2"/><text x="80" y="42" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-size="26" fill="#fff">Ford</text></svg>
					</span>
					<span class="plat plat-ram" aria-label="RAM">
						<svg viewBox="0 0 64 44" aria-hidden="true"><path d="M8 14c6-8 14-10 24-10s18 2 24 10c-6-2-12-2-16 2-3 3-5 7-8 7s-5-4-8-7c-4-4-10-4-16-2z" fill="#414042"/></svg>
						<em>RAM</em>
					</span>
				</div>
				<div class="center">
					<a href="#" class="btn btn-gold">Talk To a Van Expert</a>
				</div>
			</div>
		</section>

		<!-- Gallery -->
		<section class="stories">
			<div class="wrap stories-head">
				<div>
					<h2 class="section-title left">Custom Builds. Real Stories.</h2>
					<p class="section-lede left">
						See how Papago Vans owners have transformed their lives on the road with
						one-of-a-kind conversions.
					</p>
				</div>
				<a href="#" class="btn btn-outline btn-sm">View All <span class="arw">&#8853;</span></a>
			</div>
			<div class="stories-rail">
				{gallery.map((g) => (
					<figure class="story">
						<img src={`/home/${g.img}`} alt={g.name} />
						<figcaption>{g.name}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<!-- Testimonials -->
		<section class="reviews">
			<div class="wrap stories-head">
				<div>
					<h2 class="section-title left">Real Travelers. Real Adventures.</h2>
					<p class="section-lede left">
						Hear from our community &mdash; solo travelers, couples, families &mdash; on how
						Papago Vans helped them create a life on the move.
					</p>
				</div>
				<a href="#" class="btn btn-outline btn-sm">Read More Stories <span class="arw">&#8853;</span></a>
			</div>
			<div class="wrap review-grid">
				{[0, 1].map(() => (
					<blockquote class="review">
						<img src="/home/Frame-39.svg" alt="5 out of 5 stars" width="120" height="22" />
						<p>
							If I could give 6 stars, I would. This is a professional outfit all the way.
							From helping me source my van, to helping select the perfect options for my
							needs, they never disappointed. The components they use are all first class.
							The weekly photo updates of my build were also so greatly appreciated, kept me
							in the loop during the entire build.
						</p>
						<footer>
							<img src="/home/image-1-1.webp" alt="" width="48" height="48" />
							<div>
								<cite>Yale Popowich</cite>
								<span>Full-time van lifers, 2+ years on the road</span>
							</div>
						</footer>
					</blockquote>
				))}
			</div>
		</section>

		<!-- Footer -->
		<footer class="site-footer">
			<img class="footer-art" src="/home/Frame-66.svg" alt="" aria-hidden="true" />
			<div class="wrap footer-inner">
				<div class="footer-cols">
					{footerCols.map((c) => (
						<div class="footer-col">
							<h4>{c.h}</h4>
							<ul>{c.links.map((l) => <li><a href="#">{l}</a></li>)}</ul>
						</div>
					))}
				</div>
				<div class="footer-bottom">
					<img src="/home/Group-21-1.svg" alt="Papago Vans" width="120" height="72" />
					<p class="copyright">&copy; 2026 Papago Vans. All rights reserved</p>
					<div class="social">
						{["f", "t", "in", "@"].map((s) => <a href="#" aria-label="Social"><span>{s}</span></a>)}
					</div>
				</div>
			</div>
		</footer>

		<style is:global>
			:root {
				--gold: #f4d969;
				--gold-deep: #e9ca47;
				--ink: #414042;
				--muted: #69727d;
				--dark: #1f2124;
				--blue: #6c93b7;
				--footer: #303c47;   /* navy: same value Frame-66.svg paints with, and the build app */
				--line: #ededed;
				--soft: #f8f8f8;
			}
			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body {
				margin: 0;
				font-family: Prompt, sans-serif;
				font-size: 16px;
				line-height: 1.6;
				color: var(--ink);
				background: #fff;
				-webkit-font-smoothing: antialiased;
			}
			img { max-width: 100%; display: block; }
			h1, h2, h3, h4 { margin: 0; font-weight: 700; line-height: 1.15; }
			p { margin: 0; }
			a { color: inherit; text-decoration: none; }
			ul { margin: 0; padding: 0; list-style: none; }
			.wrap { width: min(1200px, 100% - 48px); margin-inline: auto; }
			.center { text-align: center; }

			/* Buttons */
			.btn {
				display: inline-flex; align-items: center; justify-content: center; gap: 8px;
				padding: 14px 30px; border-radius: 999px; font-size: 15px; font-weight: 600;
				border: 1.5px solid transparent; cursor: pointer; transition: 0.18s ease;
				white-space: nowrap;
			}
			.btn-gold { background: var(--gold); color: var(--ink); }
			.btn-gold:hover { background: var(--gold-deep); }
			.btn-outline { border-color: var(--gold); color: var(--ink); background: transparent; }
			.btn-outline:hover { background: var(--gold); }
			.btn-sm { padding: 10px 22px; font-size: 14px; }
			.btn-block { width: 100%; }
			.arw { font-size: 17px; line-height: 1; }

			/* Header */
			.site-header { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 50; }
			.header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 18px 0; }
			.main-nav { display: flex; gap: 34px; font-size: 15px; font-weight: 500; }
			.main-nav a:hover { color: var(--muted); }
			.header-actions { display: flex; align-items: center; gap: 16px; }
			.hamburger { width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 50%; background: #fff; display: grid; place-content: center; gap: 4px; cursor: pointer; }
			.hamburger span { display: block; width: 16px; height: 2px; background: var(--ink); }

			/* Hero */
			.hero { position: relative; margin: 24px auto 0; width: min(1200px, 100% - 48px); border-radius: 18px; overflow: hidden; min-height: 520px; display: flex; align-items: flex-end; }
			.hero-media { position: absolute; inset: 0; }
			.hero-media img { width: 100%; height: 100%; object-fit: cover; }
			.hero-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,20,22,0.82) 0%, rgba(20,20,22,0.45) 55%, rgba(20,20,22,0.25) 100%); }
			.hero-inner { position: relative; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; padding: 64px 0; color: #fff; }
			.hero-copy { max-width: 560px; }
			.hero-copy h1 { font-size: clamp(34px, 5vw, 50px); }
			.hero-copy p { margin-top: 18px; font-size: 16px; color: rgba(255,255,255,0.88); max-width: 460px; }
			.hero-ctas { display: flex; flex-direction: column; gap: 12px; min-width: 220px; }
			.hero-ctas .btn-outline { color: #fff; }
			.hero-ctas .btn-outline:hover { color: var(--ink); }

			/* Stats */
			.stats { padding: 44px 0 8px; }
			.stats-inner { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; text-align: center; }
			.stat img { margin: 0 auto 10px; width: 32px; height: 32px; }
			.stat-value { font-size: 26px; font-weight: 700; }
			.stat-value span { font-size: 12px; font-weight: 600; vertical-align: super; margin-left: 2px; }
			.stat-label { font-size: 13px; color: var(--muted); }

			/* Three ways to buy (new) */
			.paths { padding: 72px 0 8px; }
			.paths-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; align-items: stretch; }
			.path-card {
				position: relative; display: flex; flex-direction: column;
				border: 1px solid var(--line); border-radius: 18px; padding: 34px 30px 30px;
				background: #fff; transition: 0.18s ease;
			}
			.path-card:hover { border-color: var(--gold); }
			.path-card.is-featured { border-color: var(--gold); border-width: 2px; background: var(--soft); padding-top: 38px; }
			.path-flag {
				position: absolute; top: -13px; left: 30px; background: var(--gold); color: var(--ink);
				font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
				padding: 6px 14px; border-radius: 999px;
			}
			.path-kicker { font-size: 12px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--muted); }
			.path-name { font-size: 26px; margin: 8px 0 14px; }
			.path-copy { color: var(--muted); font-size: 15px; }
			/* Pins the price and button to the bottom so all three line up. */
			.path-foot { margin-top: auto; padding-top: 26px; }
			.path-range-label { font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }
			.path-range { font-size: 19px; font-weight: 700; margin: 2px 0 20px; }

			/* Build app band (new) */
			.buildapp { margin: 56px 0 8px; }
			.buildapp-inner { background: var(--dark); border-radius: 18px; overflow: hidden; display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; }
			.buildapp-copy { padding: 56px 48px; color: #fff; }
			.buildapp-copy .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); }
			.buildapp-copy h2 { font-size: clamp(28px, 3.4vw, 38px); margin: 10px 0 14px; }
			.buildapp-copy p { color: rgba(255,255,255,0.78); max-width: 460px; margin-bottom: 26px; }
			.buildapp-art { align-self: stretch; }
			.buildapp-art img { width: 100%; height: 100%; object-fit: cover; min-height: 320px; }

			/* Sections */
			.section-title { font-size: clamp(26px, 3.2vw, 36px); text-align: center; }
			.section-lede { max-width: 720px; margin: 14px auto 0; text-align: center; color: var(--muted); font-size: 15px; }
			.section-title.left, .section-lede.left { text-align: left; margin-left: 0; }

			/* Builds */
			.builds { padding: 72px 0; }
			.builds-rail { display: flex; align-items: center; gap: 16px; margin-top: 40px; }
			.rail-btn { flex: none; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line); background: #fff; font-size: 20px; color: var(--ink); cursor: pointer; }
			.builds-grid { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
			.build-card { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }
			.build-img { padding: 14px 14px 0; }
			.build-img img { border-radius: 10px; width: 100%; height: 170px; object-fit: cover; }
			.build-body { padding: 18px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
			.build-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
			.build-head h3 { font-size: 20px; }
			.price-pill { background: var(--gold); border-radius: 999px; padding: 5px 12px; font-size: 11px; font-weight: 600; white-space: nowrap; }
			.build-copy { font-size: 13px; color: var(--muted); flex: 1; }
			.build-specs, .papago-specs { display: flex; justify-content: space-between; gap: 8px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 12px 0; }
			.papago-specs { justify-content: flex-start; gap: 34px; }
			.spec { display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); }

			/* The Papago */
			.papago { background: var(--blue); padding: 64px 0; }
			.papago-inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 0; }
			.papago-img img { border-radius: 14px; width: 100%; height: 340px; object-fit: cover; }
			.papago-card { background: #fff; border-radius: 14px; padding: 42px; margin-left: -40px; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
			.papago-card h2 { font-size: 30px; }
			.papago-card p { font-size: 14px; color: var(--muted); }

			/* Process */
			.process { padding: 72px 0; }
			.process-inner { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px; align-items: start; }
			.process-head h2 { font-size: clamp(26px, 3.2vw, 34px); }
			.process-head p { margin-top: 16px; color: var(--muted); font-size: 15px; }
			.process-steps { display: flex; flex-direction: column; gap: 18px; }
			.step-row { display: grid; grid-template-columns: 190px 1fr; gap: 18px; align-items: stretch; }
			.step-img img { width: 100%; height: 100%; min-height: 110px; object-fit: cover; border-radius: 12px; }
			.step-card { border: 1px solid var(--line); border-radius: 12px; padding: 22px; display: flex; gap: 18px; align-items: center; }
			.step-num { flex: none; width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid var(--gold); display: grid; place-content: center; font-weight: 700; }
			.step-card h3 { font-size: 19px; }
			.step-card p { font-size: 13px; color: var(--muted); margin-top: 5px; }

			/* Platforms */
			.platforms { padding: 64px 0 76px; background: var(--soft); }
			.platform-logos { display: flex; align-items: center; justify-content: center; gap: 90px; margin: 46px 0 40px; flex-wrap: wrap; }
			.plat { display: flex; flex-direction: column; align-items: center; gap: 8px; }
			.plat svg { height: 58px; width: auto; }
			.plat em { font-style: normal; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; }
			.plat-ram svg { height: 40px; }

			/* Stories */
			.stories { padding: 72px 0 0; }
			.stories-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; flex-wrap: wrap; }
			.stories-rail { display: flex; gap: 18px; margin-top: 38px; padding: 0 24px 6px; overflow-x: auto; scrollbar-width: none; }
			.stories-rail::-webkit-scrollbar { display: none; }
			.story { margin: 0; flex: 0 0 380px; }
			.story img { border-radius: 14px; width: 100%; height: 250px; object-fit: cover; }
			.story figcaption { margin-top: 12px; font-weight: 600; font-size: 15px; }

			/* Reviews */
			.reviews { padding: 72px 0; }
			.review-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 38px; }
			.review { margin: 0; border: 1px solid var(--line); border-radius: 14px; padding: 30px; display: flex; flex-direction: column; gap: 16px; }
			.review p { font-size: 14px; color: var(--muted); }
			.review footer { display: flex; align-items: center; gap: 12px; }
			.review footer img { border-radius: 50%; width: 48px; height: 48px; object-fit: cover; }
			.review cite { display: block; font-style: normal; font-weight: 600; font-size: 15px; }
			.review footer span { font-size: 12px; color: var(--muted); }

			/* Footer */
			.site-footer { position: relative; background: var(--footer); color: #fff; padding: 120px 0 36px; margin-top: 40px; overflow: hidden; }
			/* Frame-66.svg IS the footer scene, navy ridges and saguaro, not a watermark. */
			.footer-art { position: absolute; left: 50%; transform: translateX(-50%); bottom: 0; width: 100%; min-width: 1280px; pointer-events: none; }
			.footer-inner { position: relative; }
			.footer-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
			.footer-col h4 { color: var(--gold); font-size: 15px; margin-bottom: 14px; }
			.footer-col li { margin-bottom: 9px; }
			.footer-col a { font-size: 13px; color: rgba(255,255,255,0.8); }
			.footer-col a:hover { color: #fff; }
			.footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 64px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.14); flex-wrap: wrap; }
			.copyright { font-size: 12px; color: rgba(255,255,255,0.7); }
			.social { display: flex; gap: 10px; }
			.social a { width: 32px; height: 32px; border-radius: 7px; background: rgba(255,255,255,0.12); display: grid; place-content: center; font-size: 12px; font-weight: 600; }

			@media (max-width: 1000px) {
				.main-nav { display: none; }
				.buildapp-inner, .papago-inner, .process-inner { grid-template-columns: 1fr; }
				.papago-card { margin-left: 0; margin-top: -30px; }
				.builds-grid { grid-template-columns: 1fr; }
				.paths-grid { grid-template-columns: 1fr; gap: 26px; }
				.rail-btn { display: none; }
				.review-grid { grid-template-columns: 1fr; }
				.stats-inner { grid-template-columns: repeat(3, 1fr); row-gap: 28px; }
				.footer-cols { grid-template-columns: repeat(2, 1fr); }
				.step-row { grid-template-columns: 120px 1fr; }
			}
			@media (max-width: 640px) {
				.hero { min-height: 460px; }
				.hero-ctas { width: 100%; }
				.stats-inner { grid-template-columns: repeat(2, 1fr); }
				.buildapp-copy { padding: 38px 26px; }
				.story { flex-basis: 280px; }
			}
		</style>
	</body>
</html>
