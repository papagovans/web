---
/*
 * Home page mockup for go.papagovans.com/home
 *
 * A rebuild of the new homepage the agency has on staging at
 * papagovansdev.wpenginepowered.com, so Papago can iterate on it without
 * waiting on the agency. Type, palette and layout are copied from the live
 * staging DOM rather than eyeballed:
 *
 *   Prompt          typeface, same as the build configurator
 *   #F4D969         gold, primary action
 *   #414042         body copy
 *   #69727D         muted copy
 *   #6C93B7         blue band behind "The Papago"
 *   #303C47         footer navy, the value Frame-66.svg paints its ridges with,
 *                   and the same navy the build configurator already uses
 *
 * Four deliberate differences from staging:
 *   1. The hero is a still rather than the video loop.
 *   2. Staging's five-stat bar under the hero is gone.
 *   3. A "Build Your Van One of Three Ways" section takes its place,
 *      splitting buyers between Signature, Tailored and Bespoke.
 *   4. A "Build Your Van" band sits below that, pointing at
 *      build.papagovans.com. Neither of those exists on staging.
 *
 * Every nav and card link is href="#" on purpose. This is a mockup.
 */

import Site from "../layouts/Site.astro";

const BUILD_APP = "https://build.papagovans.com";

const builds = [
	{
		name: "El Capitan",
		price: "Starts at $127,395+",
		img: "image-1-4.webp",
		copy: "This is our top-tier luxury build, featuring premium finishes, custom upgrades, and adventure-ready options. Its spacious, flexible layout is perfect for families or larger groups who want to travel without limits.",
		specs: ["2-6", "920Ah", "Yes", "33G"],
	},
	{
		name: "Build Layout 4",
		price: "Starts at $86,795",
		img: "JMO_1216.webp",
		copy: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
		specs: ["2-6", "460Ah", "Yes", "33G"],
	},
	{
		name: "Build Layout 3",
		price: "Starts at $108,595",
		img: "image-5.webp",
		copy: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua",
		specs: ["2-6", "920Ah", "Yes", "33G"],
	},
];

/*
 * Three ways to buy. The ladder is deliberate: each step down trades speed for
 * control, and the price range rises with it, so the order reads as a decision
 * rather than a menu. "Tailored" is the name for the configurator tier; it sits
 * between Signature (fixed) and Bespoke (from scratch) in both senses.
 */
const paths = [
	{
		name: "Signature Pre-Build",
		kicker: "Fastest to the road",
		copy: "Layouts we designed ourselves after years of building vans, then refined over and over. Floor plan and cabinetry are set, which is exactly why they cost less and ship soonest. Pick your finishes and go.",
		range: "$180,000 &ndash; $240,000",
		cta: "Explore Signature Builds",
		href: "/signature",
		featured: false,
	},
	{
		name: "Tailored",
		kicker: "Build your van online",
		copy: "Start from a signature floor plan and configure every system yourself: power, water, heat, kitchen, storage, finishes. Watch the price move as you go, then download your Build Sheet. Second fastest way to get your van.",
		range: "$190,000 &ndash; $250,000",
		cta: "Start Building",
		href: BUILD_APP,
		featured: true,
	},
	{
		name: "Bespoke",
		kicker: "Built from scratch",
		copy: "A blank van and a designer. Your layout, your cabinetry, your ideas. Nearly anything is on the table. It costs more and takes 9 to 12 months, and for the right owner it is worth every week of it.",
		range: "$200,000 &ndash; $300,000",
		cta: "Talk to a Designer",
		href: "#",
		featured: false,
	},
];

const steps = [
	{
		n: "1",
		img: "image-2.webp",
		title: "Choose Your Layout",
		copy: "Browse your signature models and pick a layout that fits your lifestyle.",
	},
	{
		n: "2",
		img: "image-4.webp",
		title: "Customize Your Build",
		copy: "Select your base chassis and personalize everything from power systems to storage and upgrades.",
	},
	{
		n: "3",
		img: "image-2-2.webp",
		title: "We Build, You Travel",
		copy: "Our expert team builds your van with precision, updating you at every stage until delivery day.",
	},
];

const gallery = [
	{ img: "Papago-Sprinter-Camper-Van-Completed-Build-11-768x512.jpeg", name: "The Northrop Van" },
	{ img: "On-the-Brink-Van-3-Large-768x512.jpeg", name: "The Brinkman Van" },
	{ img: "Sweeney-Van-Final-Shots-1-Large-768x512.jpeg", name: "The Cherry Van" },
	{ img: "Papago-Sprinter-Camper-Van-Complete-170-3500-17-Large-768x512.jpeg", name: "The Turner Van" },
];

const footerCols = [
	{ h: "Campers", links: ["El Capitan", "Olympus", "Four Peaks", "Rainier"] },
	{ h: "Resources", links: ["About Us", "News", "FAQ", "Financing"] },
	{ h: "Services", links: ["Interior Installation", "Exterior Upgrades", "Heating and cooling", "Partial Build"] },
	{ h: "Policies", links: ["Terms & Conditions", "Privacy Policy", "CCPA"] },
];
---

<Site title="Arizona Campervan Conversions | Custom Vans by Papago">

		<!-- Hero. Staging runs a video loop here; a still stands in for the mockup. -->
		<section class="hero">
			<div class="hero-media">
				<img src="/home/On-the-Brink-Van-9-Large.jpeg" alt="A Papago Vans Sprinter conversion parked on desert flats below the Four Peaks" />
			</div>
			<div class="wrap hero-inner">
				<div class="hero-copy">
					<h1>Camper Vans<br />Built To Explore</h1>
					<p>
						From weekend escapes to full-range adventures, Papago Vans delivers rugged,
						high-performance conversions ready for any terrain.
					</p>
				</div>
				<div class="hero-ctas">
					<a href="#" class="btn btn-outline">View Models</a>
					<a href="#" class="btn btn-gold">Get Started <span class="arw">&#8853;</span></a>
				</div>
			</div>
		</section>

		<!-- NEW: three ways to buy. Not on staging. -->
		<section class="paths">
			<div class="wrap">
				<h2 class="section-title">Build Your Van One of Three Ways</h2>
				<p class="section-lede">
					Every Papago is built by hand in Mesa, Arizona. The only question is how much
					of it you want to decide. Every price includes the Mercedes-Benz Sprinter.
				</p>
				<div class="paths-grid">
					{paths.map((p) => (
						<article class={p.featured ? "path-card is-featured" : "path-card"}>
							{p.featured && <span class="path-flag">Most Popular</span>}
							<p class="path-kicker">{p.kicker}</p>
							<h3 class="path-name">{p.name}</h3>
							<p class="path-copy">{p.copy}</p>
							<div class="path-foot">
								<p class="path-range-label">Pricing Range</p>
								<p class="path-range" set:html={p.range} />
								<a href={p.href} class={p.featured ? "btn btn-gold btn-block" : "btn btn-outline btn-block"}>
									{p.cta} <span class="arw">&#8853;</span>
								</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- NEW: build configurator band. Not on staging. -->
		<section class="buildapp">
			<div class="wrap buildapp-inner">
				<div class="buildapp-copy">
					<p class="eyebrow">New</p>
					<h2>Build Your Van Online</h2>
					<p>
						Pick a floor plan, choose a trim package, and customize every system with a
						running price. Download your Build Sheet when you&rsquo;re done. Every price
						includes the Mercedes-Benz Sprinter.
					</p>
					<a href={BUILD_APP} class="btn btn-gold">Start Building <span class="arw">&#8853;</span></a>
				</div>
				<div class="buildapp-art">
					<img src="/home/Northrop-Sprinter-144-Final-Pics-30-Large.jpeg" alt="Papago Vans Sprinter conversion in the Arizona desert" />
				</div>
			</div>
		</section>

		<!-- Signature builds -->
		<section class="builds">
			<div class="wrap">
				<h2 class="section-title">Explore Our Signature Builds</h2>
				<p class="section-lede">
					Each layout is crafted with precision for different travel lifestyles. Whether
					you&rsquo;re off-roading, remote working, or traveling with your dog &mdash; we have a
					van for that.
				</p>
			</div>
			<div class="wrap builds-rail">
				<button class="rail-btn rail-prev" aria-label="Previous">&#8249;</button>
				<div class="builds-grid">
					{builds.map((b) => (
						<article class="build-card">
							<div class="build-img"><img src={`/home/${b.img}`} alt={b.name} /></div>
							<div class="build-body">
								<div class="build-head">
									<h3>{b.name}</h3>
									<span class="price-pill">{b.price}</span>
								</div>
								<p class="build-copy">{b.copy}</p>
								<div class="build-specs">
									{b.specs.map((sp) => (
										<div class="spec"><img src="/home/Group-280.svg" alt="" width="18" height="18" /><span>{sp}</span></div>
									))}
								</div>
								<a href="#" class="btn btn-outline btn-block">Explore <span class="arw">&#8853;</span></a>
							</div>
						</article>
					))}
				</div>
				<button class="rail-btn rail-next" aria-label="Next">&#8250;</button>
			</div>
		</section>

		<!-- The Papago -->
		<section class="papago">
			<div class="wrap papago-inner">
				<div class="papago-img">
					<img src="/home/papago-model.jpeg" alt="The Papago van model parked on a desert road" />
				</div>
				<div class="papago-card">
					<h2>The Papago</h2>
					<p>
						Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem
						Ipsum has been the industry&rsquo;s standard dummy text ever since the 1500s,
					</p>
					<div class="papago-specs">
						{["2-6", "800Ah", "33G"].map((sp) => (
							<div class="spec"><img src="/home/Group-280.svg" alt="" width="18" height="18" /><span>{sp}</span></div>
						))}
					</div>
					<a href="#" class="btn btn-gold">Book A Call With Us <span class="arw">&#8853;</span></a>
				</div>
			</div>
		</section>

		<!-- Process -->
		<section class="process">
			<div class="wrap process-inner">
				<div class="process-head">
					<h2>How Your Dream<br />Van Comes To Life</h2>
					<p>
						At Papago Vans, we make the process simple, smooth, and actually enjoyable from
						first call to final keys.
					</p>
				</div>
				<div class="process-steps">
					{steps.map((s) => (
						<div class="step-row">
							<div class="step-img"><img src={`/home/${s.img}`} alt="" /></div>
							<div class="step-card">
								<span class="step-num">{s.n}</span>
								<div>
									<h3>{s.title}</h3>
									<p>{s.copy}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Platforms -->
		<section class="platforms">
			<div class="wrap">
				<h2 class="section-title">Van Platforms We Work With</h2>
				<p class="section-lede">
					We work with the most trusted vans on the market and guide you through choosing
					(or sourcing) the right one for your build.
				</p>
				<div class="platform-logos">
					<span class="plat plat-mb" aria-label="Mercedes-Benz">
						<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="none" stroke="#414042" stroke-width="3"/><path d="M32 32 32 5 M32 32 8.5 46 M32 32 55.5 46" stroke="#414042" stroke-width="3" fill="none"/></svg>
						<em>Mercedes-Benz</em>
					</span>
					<span class="plat plat-ford" aria-label="Ford">
						<svg viewBox="0 0 160 64" aria-hidden="true"><ellipse cx="80" cy="32" rx="78" ry="30" fill="#1B4C9B"/><ellipse cx="80" cy="32" rx="73" ry="26" fill="none" stroke="#fff" stroke-width="2"/><text x="80" y="42" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-size="26" fill="#fff">Ford</text></svg>
					</span>
					<span class="plat plat-ram" aria-label="RAM">
						<svg viewBox="0 0 64 44" aria-hidden="true"><path d="M8 14c6-8 14-10 24-10s18 2 24 10c-6-2-12-2-16 2-3 3-5 7-8 7s-5-4-8-7c-4-4-10-4-16-2z" fill="#414042"/></svg>
						<em>RAM</em>
					</span>
				</div>
				<div class="center">
					<a href="#" class="btn btn-gold">Talk To a Van Expert</a>
				</div>
			</div>
		</section>

		<!-- Gallery -->
		<section class="stories">
			<div class="wrap stories-head">
				<div>
					<h2 class="section-title left">Custom Builds. Real Stories.</h2>
					<p class="section-lede left">
						See how Papago Vans owners have transformed their lives on the road with
						one-of-a-kind conversions.
					</p>
				</div>
				<a href="#" class="btn btn-outline btn-sm">View All <span class="arw">&#8853;</span></a>
			</div>
			<div class="stories-rail">
				{gallery.map((g) => (
					<figure class="story">
						<img src={`/home/${g.img}`} alt={g.name} />
						<figcaption>{g.name}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<!-- Testimonials -->
		<section class="reviews">
			<div class="wrap stories-head">
				<div>
					<h2 class="section-title left">Real Travelers. Real Adventures.</h2>
					<p class="section-lede left">
						Hear from our community &mdash; solo travelers, couples, families &mdash; on how
						Papago Vans helped them create a life on the move.
					</p>
				</div>
				<a href="#" class="btn btn-outline btn-sm">Read More Stories <span class="arw">&#8853;</span></a>
			</div>
			<div class="wrap review-grid">
				{[0, 1].map(() => (
					<blockquote class="review">
						<img src="/home/Frame-39.svg" alt="5 out of 5 stars" width="120" height="22" />
						<p>
							If I could give 6 stars, I would. This is a professional outfit all the way.
							From helping me source my van, to helping select the perfect options for my
							needs, they never disappointed. The components they use are all first class.
							The weekly photo updates of my build were also so greatly appreciated, kept me
							in the loop during the entire build.
						</p>
						<footer>
							<img src="/home/image-1-1.webp" alt="" width="48" height="48" />
							<div>
								<cite>Yale Popowich</cite>
								<span>Full-time van lifers, 2+ years on the road</span>
							</div>
						</footer>
					</blockquote>
				))}
			</div>
		</section>


</Site>
