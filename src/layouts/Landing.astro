---
/*
 * The document shell every paid landing page shares: tracking, fonts and the
 * landing stylesheet. The ad pages and the thank-you page both sit in it, so
 * the pixel and the Google tag cannot be missing from one of them.
 */
import "../styles/landing.css";

interface Props {
	title: string;
	description: string;
	/** The hero photograph, fetched ahead of everything else. */
	preload?: string;
}

const { title, description, preload } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Stops phones turning the printed number and address into links. -->
		<meta name="format-detection" content="telephone=no, email=no, address=no" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Prompt:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<!-- Google tag (Papago Vans Google Ads: AW-11054135599) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=AW-11054135599"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { window.dataLayer.push(arguments); }
			gtag("js", new Date());
			gtag("config", "AW-11054135599");
		</script>

		<!-- Meta Pixel (Papago Vans's Pixel: 611277970549442) -->
		<script is:inline>
			!(function (f, b, e, v, n, t, s) {
				if (f.fbq) return;
				n = f.fbq = function () {
					n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
				};
				if (!f._fbq) f._fbq = n;
				n.push = n;
				n.loaded = !0;
				n.version = "2.0";
				n.queue = [];
				t = b.createElement(e);
				t.async = !0;
				t.src = v;
				s = b.getElementsByTagName(e)[0];
				s.parentNode.insertBefore(t, s);
			})(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
			fbq("init", "611277970549442");
			fbq("track", "PageView");
		</script>
		<noscript>
			<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=611277970549442&ev=PageView&noscript=1" />
		</noscript>
	</head>
	<body>
		<slot />
	</body>
</html>
