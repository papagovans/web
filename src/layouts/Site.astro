---
/*
 * Shared shell for the homepage mockup and everything hanging off it.
 *
 * Header, footer and the whole stylesheet live here so a second page cannot
 * drift from the first. Page-specific CSS goes in the page's own
 * <style is:global> block.
 *
 * Every nav and footer link is href="#" on purpose. This is a mockup.
 */
import "../styles/site.css";

interface Props {
	title: string;
}

const { title } = Astro.props;

const PHONE = "+1 602-346-0331";

const footerCols = [
	// Staging lists "Four Peaks" here, which is not a plan in the build
	// configurator's catalog. Using the real five so the footer and /signature
	// cannot contradict each other inside the same mockup.
	{ h: "Campers", links: ["El Capitan", "Zion", "Olympus", "Mammoth", "Rainier"] },
	{ h: "Resources", links: ["About Us", "News", "FAQ", "Financing"] },
	{ h: "Services", links: ["Interior Installation", "Exterior Upgrades", "Heating and cooling", "Partial Build"] },
	{ h: "Policies", links: ["Terms & Conditions", "Privacy Policy", "CCPA"] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- Header -->
		<header class="site-header">
			<div class="wrap header-inner">
				<a href="/home" class="logo" aria-label="Papago Vans home">
					<img src="/home/Group-278.svg" alt="Papago Vans" width="174" height="27" />
				</a>
				<nav class="main-nav" aria-label="Main">
					<a href="#">View Models</a>
					<a href="#">Let&rsquo;s Get Started</a>
					<a href="#">View Recent Builds</a>
				</nav>
				<div class="header-actions">
					<a href="#" class="btn btn-outline btn-sm">Call Now: {PHONE}</a>
					<button class="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
				</div>
			</div>
		</header>

		<slot />

		<!-- Footer -->
		<footer class="site-footer">
			<img class="footer-art" src="/home/Frame-66.svg" alt="" aria-hidden="true" />
			<div class="wrap footer-inner">
				<div class="footer-cols">
					{footerCols.map((c) => (
						<div class="footer-col">
							<h4>{c.h}</h4>
							<ul>{c.links.map((l) => <li><a href="#">{l}</a></li>)}</ul>
						</div>
					))}
				</div>
				<div class="footer-bottom">
					<img src="/home/Group-21-1.svg" alt="Papago Vans" width="120" height="72" />
					<p class="copyright">&copy; 2026 Papago Vans. All rights reserved</p>
					<div class="social">
						{["f", "t", "in", "@"].map((s) => <a href="#" aria-label="Social"><span>{s}</span></a>)}
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
